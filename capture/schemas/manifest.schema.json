{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CipherScope session manifest",
  "description": "Ground-truth manifest per lab session (mvp.md §3.2).",
  "type": "object",
  "required": ["session_id", "profile", "traffic_type", "start", "end",
               "gateways", "labels", "pcap", "keys"],
  "properties": {
    "session_id": { "type": "string", "examples": ["p07-voip-0003"] },
    "profile": { "type": "string", "pattern": "^p[0-9]{2}$" },
    "traffic_type": { "enum": ["icmp", "web", "email", "voip", "video", "messaging", "bulk"] },
    "start": { "type": "string" },
    "end": { "type": "string" },
    "gateways": { "type": "array", "items": { "type": "string" } },
    "labels": {
      "type": "object",
      "required": ["ike_version", "mode", "enc", "key_bits", "integ",
                   "dh_group", "pfs", "nat_t", "child_rekey_s", "replay_window"],
      "properties": {
        "ike_version": { "enum": [1, 2] },
        "mode": { "enum": ["tunnel", "transport"] },
        "enc": { "type": "string", "examples": ["AES-GCM-16", "AES-CBC"] },
        "key_bits": { "enum": [128, 256] },
        "integ": { "type": "string", "examples": ["AEAD", "HMAC-SHA1-96", "HMAC-SHA2-256-128"] },
        "dh_group": { "type": "integer" },
        "pfs": { "type": "boolean" },
        "nat_t": { "type": "boolean" },
        "child_rekey_s": { "type": "integer" },
        "replay_window": { "type": "integer", "minimum": 0 }
      }
    },
    "pcap": { "type": "string" },
    "keys": { "type": "string" }
  }
}
