# Ports, paths, feature flags. No secrets needed (PSKs are lab-only, see lab/profiles).
CS_DATA_DIR=./data
CS_MODELS_DIR=./models
CS_RULES_DIR=./rules

# API
CS_MAX_UPLOAD_MB=500
CS_LIVE_ENABLED=false
CS_LIVE_INTERFACE=eth0

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001

# Grafana (SOC dashboards, provisioned from ./grafana)
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cipherscope-soc

# Lab
LAB_BRIDGE_SUBNET_V4=172.30.0.0/24
LAB_BRIDGE_SUBNET_V6=fd30::/64
LAB_INNER_NET_A_V4=10.1.0.0/24
LAB_INNER_NET_A_V6=fd01::/64
LAB_INNER_NET_B_V4=10.2.0.0/24
LAB_INNER_NET_B_V6=fd02::/64
