{# Rendered by lab/runner/render.py from a validated profile YAML (mvp.md §3.1). #}
connections {
  {{ profile.id }} {
    version = {{ profile.ike_version }}
    {# Peer gateway per lab/network/bridges.yaml: role-aware via render.py. #}
    remote_addrs = {{ peer_addr }}
    proposals = {{ profile.ike_proposal | swan_prop }}
    rekey_time = {{ profile.ike_lifetime }}
    local {
      auth = psk
      id = {{ local_id }}
    }
    remote {
      auth = psk
      id = {{ remote_id }}
    }
    children {
      {{ profile.id }}-child {
{% if profile.ike_version == 1 %}
{# IKEv1 profiles render through ipsec.conf.ikev1.j2 instead; this branch is a fallback. #}
{% endif %}
{% if profile.mode == "tunnel" %}
        mode = tunnel
{% else %}
        mode = transport
{% endif %}
{% if profile.esp_proposal.startswith("ah-") %}
        {# AH-only: any ah_proposals entry makes strongSwan use AH instead of ESP. #}
        ah_proposals = {{ profile.esp_proposal[3:] | swan_prop }}
{% else %}
        esp_proposals = {{ profile.esp_proposal | swan_prop }}
{% endif %}
        rekey_time = {{ profile.child_rekey_time }}
        replay_window = {{ profile.replay_window }}
        local_ts  = {{ local_ts }}
        remote_ts = {{ remote_ts }}
{% if profile.pfs %}
        {# PFS on: the DH group at the end of esp_proposal is used on CREATE_CHILD_SA rekey. #}
{% else %}
        {# PFS off: esp_proposal carries no DH group. #}
{% endif %}
      }
    }
  }
}

secrets {
  ike-a {
    id = gw-a
    secret = {{ psk }}
  }
  ike-b {
    id = gw-b
    secret = {{ psk }}
  }
}
