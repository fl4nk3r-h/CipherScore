{# Legacy IKEv1 template (profiles p13, p14). strongSwan 5.x renders IKEv1 via ipsec.conf/stroke. #}
config setup
  uniqueids=yes

conn {{ profile.id }}
  keyexchange=ikev1
  type={{ "tunnel" if profile.mode == "tunnel" else "transport" }}
  authby=psk
  ike={{ profile.ike_proposal | swan_prop }}
  esp={{ profile.esp_proposal | swan_prop }}
  ikelifetime={{ profile.ike_lifetime }}
  lifetime={{ profile.child_rekey_time }}
  replay_window={{ profile.replay_window }}
  {# strongSwan 5.x: 'pfs' keyword is deprecated; a DH group in esp= enables PFS. #}
  {% if profile.pfs %}{# esp_proposal carries the DH group for PFS rekeying #}{% endif %}
  {# Subnets are per-side (gw-a fronts 10.1/fd01, gw-b 10.2/fd02): role-aware via render.py. #}
  leftsubnet={{ local_ts }}
  rightsubnet={{ remote_ts }}
  left=%defaultroute
  right={{ peer_addr }}
  auto=start
